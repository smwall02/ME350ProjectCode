\cf2 500 \cf0 // This is a function to update the encoder count in the Arduino. //\
\cf2 501 \cf0 // It is called via an interrupt whenever the value on encoder //\
\cf2 502 \cf0 // channel A or B changes. //\
\cf2 503 \cf0 //////////////////////////////////////////////////////////////////////\
\cf2 504 \cf0 void updateMotorPosition() \{\
\cf2 505 \cf0 // Bitwise shift left by one bit, to make room for a bit of new data:\
\cf2 506 \cf0 encoderStatus <<= 1;\
\cf2 507 \cf0 // Use a compound bitwise OR operator (|=) to read the A channel of the encoder (pin 2)\
\cf2 508 \cf0 // and put that value into the rightmost bit of encoderStatus:\
\cf2 509 \cf0 encoderStatus |= digitalRead(2);\
\cf2 510 \cf0 // Bitwise shift left by one bit, to make room for a bit of new data:\
\cf2 511 \cf0 encoderStatus <<= 1;\
\cf2 512 \cf0 // Use a compound bitwise OR operator (|=) to read the B channel of the encoder (pin\
3)\
\cf2 513 \cf0 // and put that value into the rightmost bit of encoderStatus:\
\cf2 514 \cf0 encoderStatus |= digitalRead(3);\
\cf2 515 \cf0 // encoderStatus is truncated to only contain the rightmost 4 bits by using a\
\cf2 516 \cf0 // bitwise AND operator on mstatus and 15(=1111):\
\cf2 517 \cf0 encoderStatus &= 15;\
\cf2 518 \cf0 if (encoderStatus==2 || encoderStatus==4 || encoderStatus==11 || encoderStatus==13) \{\
\cf2 519 \cf0 // the encoder status matches a bit pattern that requires counting up by one\
\cf2 520 \cf0 motorPosition++; // increase the encoder count by one\
\cf2 521 \cf0 \}\
\cf2 522 \cf0 else if (encoderStatus == 1 || encoderStatus == 7 || encoderStatus == 8 ||\
encoderStatus == 14) \{\
\cf2 523 \cf0 // the encoder status does not match a bit pattern that requires counting up by\
one.\
\cf2 524 \cf0 // Since this function is only called if something has changed, we have to count\
downwards\
\cf2 525 \cf0 motorPosition--; // decrease the encoder count by one\
\cf2 526 \cf0 \}\
\cf2 527 \cf0 \}\
\cf2 528 \cf0 // End of function updateMotorPosition()\
