\cf2 170 \cf0 void setup() \{\
\cf2 171 \cf0 // Declare which digital pins are inputs and which are outputs:\
\cf2 172 \cf0 pinMode(PIN_NR_ENCODER_A, INPUT_PULLUP);\
\cf2 173 \cf0 pinMode(PIN_NR_ENCODER_B, INPUT_PULLUP);\
\cf2 174 \cf0 pinMode(PIN_NR_ON_OFF_SWITCH, INPUT);\
\cf2 175 \cf0 pinMode(PIN_NRL_LIMIT_SWITCH, INPUT);\
\cf2 176 \cf0 pinMode(PIN_PROXSENSE1, INPUT);\
\cf2 177 \cf0 pinMode(PIN_PROXSENSE2, INPUT);\
\cf2 178 \cf0 pinMode(PIN_PROXSENSE3, INPUT);\
\cf2 179 \cf0 pinMode(PIN_PROXSENSE4, INPUT);\
\cf2 180 \cf0 pinMode(PIN_NR_PWM_OUTPUT, OUTPUT);\
\cf2 181 \cf0 pinMode(PIN_NR_PWM_DIRECTION_1, OUTPUT);\
\cf2 182 \cf0 pinMode(PIN_NR_PWM_DIRECTION_2, OUTPUT);\
\cf2 183 \cf0 pinMode(PIN_POTENTIOMETER, INPUT);\
\cf2 184\
185 \cf0 // Turn on the pullup resistors on the encoder channels\
\cf2 186 \cf0 digitalWrite(PIN_NR_ENCODER_A, HIGH);\
\cf2 187 \cf0 digitalWrite(PIN_NR_ENCODER_B, HIGH);\
\cf2 188\
189 \cf0 // Activate interrupt for encoder pins.\
\cf2 190 \cf0 // If either of the two pins changes, the function 'updateMotorPosition' is called:\
\cf2 191 \cf0 attachInterrupt(0, updateMotorPosition, CHANGE); // Interrupt 0 is always attached to\
digital pin 2\
\cf2 192 \cf0 attachInterrupt(1, updateMotorPosition, CHANGE); // Interrupt 1 is always attached to\
digital pin 3\
\cf2 193\
194 \cf0 // Begin serial communication for monitoring.\
\cf2 195 \cf0 Serial.begin(115200);\
\cf2 196 \cf0 Serial.println("Start Executing Program.");\
\cf2 197\
198 \cf0 // Initialize sensor values\
\cf2 199 \cf0 ProxSensors[TARGET1].prevVal = analogRead(PIN_PROXSENSE1);\
\cf2 200 \cf0 ProxSensors[TARGET2].prevVal = analogRead(PIN_PROXSENSE2);\
\cf2 201 \cf0 ProxSensors[TARGET3].prevVal = analogRead(PIN_PROXSENSE3);\
\cf2 202 \cf0 ProxSensors[TARGET4].prevVal = analogRead(PIN_PROXSENSE4);\
\cf2 203\
204 \cf0 // Initialize prox sensor pins\
\cf2 205 \cf0 ProxSensors[TARGET1].pin = PIN_PROXSENSE1;\
\cf2 206 \cf0 ProxSensors[TARGET2].pin = PIN_PROXSENSE2;\
\cf2 207 \cf0 ProxSensors[TARGET3].pin = PIN_PROXSENSE3;\
