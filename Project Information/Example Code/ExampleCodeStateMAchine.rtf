\cf2 400 \cf0 // Recalibrate if we are in the leftmost position\
\cf2 401 \cf0 if (digitalRead(PIN_NRL_LIMIT_SWITCH)==HIGH && motorVelocity==0) \{\
\cf2 402 \cf0 // We reached the endstop. Update the motor position to the limit:\
