411 \cf0 //******************************************************************************//\
\cf2 412 \cf0 // Position Controller\
\cf2 413 \cf0 if (digitalRead(PIN_NR_ON_OFF_SWITCH)==HIGH) \{\
\cf2 414 \cf0 // If the toggle switch is on, run the controller:\
\cf2 415\
416 \cf0 //** PID control: **//\
\cf2 417 \cf0 // Compute the position error [encoder counts]\
\cf2 418 \cf0 positionError = desiredPosition - motorPosition;\
\cf2 419 \cf0 // Compute the integral of the position error [encoder counts * seconds]\
\cf2 420 \cf0 integralError = integralError + positionError * (float)(executionDuration) /\
1000000;\
\cf2 421 \cf0 // Compute the velocity error (desired velocity is 0) [encoder counts / seconds]\
\cf2 422 \cf0 velocityError = 0 - motorVelocity;\
\cf2 423 \cf0 // This is the actual controller function that uses the error in\
\cf2 424 \cf0 // position and velocity and the integrated error and computes a\
\cf2 425 \cf0 // desired voltage that should be sent to the motor:\
\cf2 426 \cf0 desiredVoltage = KP * positionError +\
\cf2 427 \cf0 KI * integralError +\
\cf2 428 \cf0 KD * velocityError;\
\cf2 429\
430 \cf0 //** Feedforward terms: **//\
\cf2 431 \cf0 // Compensate for friction. That is, if we now the direction of\
\cf2 432 \cf0 // desired motion, add a base command that helps with moving in this\
\cf2 433 \cf0 // direction:\
\cf2 434 \cf0 if (positionError < -5) \{\
\cf2 435 \cf0 desiredVoltage = desiredVoltage - FRICTION_COMP_VOLTAGE;\
\cf2 436 \cf0 \}\
\cf2 437 \cf0 if (positionError > +5) \{\
\cf2 438 \cf0 desiredVoltage = desiredVoltage + FRICTION_COMP_VOLTAGE;\
\cf2 439 \cf0 \}\
\cf2 440\
441 \cf0 // Anti-Wind-Up\
\cf2 442 \cf0 if (abs(desiredVoltage)>SUPPLY_VOLTAGE) \{\
\cf2 443 \cf0 // If we are already saturating our output voltage, it does not make\
\cf2 444 \cf0 // sense to keep integrating the error (and thus ask for even higher\
\cf2 445 \cf0 // and higher output voltages). Instead, stop the integrator if the\
\cf2 446 \cf0 // output saturates. We do this by reversing the summation at the\
\cf2 447 \cf0 // beginning of this function block:\
\cf2 448 \cf0 integralError = integralError - positionError * (float)(executionDuration) /\
1000000;\
\cf2 449 \cf0 \}\
\cf2 450 \cf0 // End of 'if(onOffSwitch==HIGH)'\
\cf2 451\
452 \cf0 // Override the computed voltage during calibration. In this state, we simply apply\
a\
\cf2 453 \cf0 // fixed voltage to move against one of the end-stops.\
\cf2 454 \cf0 if (state==CALIBRATE) \{\
\cf2 455 \cf0 // add calibration code here\
\cf2 456\
457 \cf0 \}\
\cf2 458 \cf0 \} else \{\
\cf2 459 \cf0 // Otherwise, the toggle switch is off, so do not run the controller,\
\cf2 460 \cf0 // stop the motor...\
\cf2 461 \cf0 desiredVoltage = 0;\
\cf2 462 \cf0 // .. and reset the integrator of the error:\
\cf2 463 \cf0 integralError = 0;\
\cf2 464 \cf0 // Produce some debugging output:\
\cf2 465 \cf0 Serial.println("The toggle switch is off. Motor Stopped.");\
\cf2 466 \cf0 \}\
\cf2 467 \cf0 // End of else onOffSwitch==HIGH\
\cf2 468\
469 \cf0 //** Send signal to motor **//\
\cf2 470 \cf0 // Convert from voltage to PWM cycle:\
\cf2 471 \cf0 motorCommand = int(abs(desiredVoltage * 255 / SUPPLY_VOLTAGE));\
\cf2 472 \cf0 // Clip values larger than 255\
\cf2 473 \cf0 if (motorCommand > 255) \{\
\cf2 474 \cf0 motorCommand = 255;\
\cf2 475 \cf0 \}\
\cf2 476 \cf0 // Send motor signals out\
\cf2 477 \cf0 analogWrite(PIN_NR_PWM_OUTPUT, motorCommand);\
\cf2 478 \cf0 // Determine rotation direction\
\cf2 479 \cf0 if (desiredVoltage >= 0) \{\
\cf2 480 \cf0 // If voltage is positive ...\
\cf2 481 \cf0 // ... turn forward\
\cf2 482 \cf0 digitalWrite(PIN_NR_PWM_DIRECTION_1,LOW); // rotate forward\
\cf2 483 \cf0 digitalWrite(PIN_NR_PWM_DIRECTION_2,HIGH); // rotate forward\
\cf2 484 \cf0 \} else \{\
\cf2 485 \cf0 // ... otherwise turn backward:\
\cf2 486 \cf0 digitalWrite(PIN_NR_PWM_DIRECTION_1,HIGH); // rotate backward\
\cf2 487 \cf0 digitalWrite(PIN_NR_PWM_DIRECTION_2,LOW); // rotate backward\
\cf2 488 \cf0 \}\
