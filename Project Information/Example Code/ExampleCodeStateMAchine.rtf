216 \cf0 /////////////////////////////////////////////////////////////////////////////////////////\
///////\
\cf2 217 \cf0 // After going through the setup() function, which initializes and sets the initial\
values, //\
\cf2 218 \cf0 // the loop() function does precisely what its name suggests, and loops\
consecutively, //\
\cf2 219 \cf0 // allowing your program to sense and respond. Use it to actively control the Arduino\
board. //\
\cf2 220 \cf0 /////////////////////////////////////////////////////////////////////////////////////////\
///////\
\cf2 221 \cf0 void loop() \{\
\cf2 222 \cf0 // Determine the duration it took to execute the last loop. This time is used\
\cf2 223 \cf0 // for integration and for monitoring the loop time via the serial monitor.\
\cf2 224 \cf0 executionDuration = micros() - lastExecutionTime;\
\cf2 225 \cf0 lastExecutionTime = micros();\
\cf2 226\
227 \cf0 // Speed Computation:\
\cf2 228 \cf0 if ((abs(motorPosition - previousMotorPosition) > MIN_VEL_COMP_COUNT) || (micros() -\
previousVelCompTime) > MIN_VEL_COMP_TIME)\{\
\cf2 229 \cf0 // If at least a minimum time interval has elapsed or\
\cf2 230 \cf0 // the motor has travelled through at least a minimum angle ...\
\cf2 231 \cf0 // .. compute a new value for speed:\
\cf2 232 \cf0 // (speed = delta angle [encoder counts] divided by delta time [seconds])\
\cf2 233 \cf0 motorVelocity = (double)(motorPosition - previousMotorPosition) * 1000000 /\
\cf2 234 \cf0 (micros() - previousVelCompTime);\
\cf2 235 \cf0 // Remember this encoder count and time for the next iteration:\
\cf2 236 \cf0 previousMotorPosition = motorPosition;\
\cf2 237 \cf0 previousVelCompTime = micros();\
\cf2 238 \cf0 \}\
\cf2 239 \cf0 // *****************************************************************************//\
\cf2 240 \cf0 // We first update the sensors so our direction information stays accurate\
\cf2 241\
242 \cf0 // Loop through each of the sensors\
\cf2 243 \cf0 for (int i = 0; i < sizeof(targetArr)/sizeof(int); i++) \{\
\cf2 244\
245 \cf0 idx = targetArr[i];\
\cf2 246 \cf0 // Updates the current sensor reading using a low pass filter\
\cf2 247 \cf0 ProxSensors[idx].currVal = alpha * ProxSensors[idx].currVal + (1 - alpha) *\
analogRead(ProxSensors[idx].pin);\
\cf2 248\
249 \cf0 // Adjusts the noise Limit based on distance to sensor (since values are not linear)\
\cf2 250 \cf0 if (ProxSensors[idx].currVal >= noiseThreshold) \{\
\cf2 251 \cf0 noiseLimit = upperNoiseLimit;\
\cf2 252 \cf0 \} else \{\
\cf2 253 \cf0 noiseLimit = lowerNoiseLimit;\
\cf2 254 \cf0 \}\
\cf2 255\
256 \cf0 // Check if sensor is stopped\
\cf2 257 \cf0 if (abs(ProxSensors[idx].currVal - ProxSensors[idx].prevVal) < noiseLimit) \{\
\cf2 258 \cf0 // if not enough time has passed to declare stopped or already stopped continue\
loop\
\cf2 259 \cf0 if (millis() - ProxSensors[idx].prevChangeTime < stopTimeout ||\
ProxSensors[idx].direction == STOPPED) \{\
\cf2 260 \cf0 ProxSensors[i].forwardCount = 0;\
\cf2 261 \cf0 ProxSensors[i].backwardCount = 0;\
\cf2 262 \cf0 continue;\
\cf2 263 \cf0 \} else \{\
\cf2 264 \cf0 // the prox sensor has been stopped for long enough that we know it is stopped\
\cf2 265 \cf0 ProxSensors[idx].direction = STOPPED;\
\cf2 266 \cf0 \}\
\cf2 267 \cf0 \} else if (ProxSensors[idx].currVal - ProxSensors[idx].prevVal < 0)\{\
\cf2 268 \cf0 // Target is moving forward, as readings decrease moving further away from the\
sensor\
\cf2 269 \cf0 ProxSensors[i].forwardCount += 1;\
\cf2 270 \cf0 // Target is moving forward\
\cf2 271 \cf0 if (ProxSensors[i].forwardCount > 3)\{\
\cf2 272 \cf0 ProxSensors[i].direction = FORWARD;\
\cf2 273\
274 \cf0 ProxSensors[i].prevVal = ProxSensors[i].currVal;\
\cf2 275 \cf0 ProxSensors[i].prevChangeTime = millis();\
\cf2 276 \cf0 \}\
\cf2 277 \cf0 \} else \{\
\cf2 278 \cf0 // Target must be moving backward\
\cf2 279 \cf0 ProxSensors[i].backwardCount += 1;\
\cf2 280 \cf0 // Target is moving forward\
\cf2 281 \cf0 if (ProxSensors[i].backwardCount > 3)\{\
\cf2 282 \cf0 ProxSensors[i].direction = BACKWARD;\
\cf2 283\
284 \cf0 ProxSensors[i].prevVal = ProxSensors[i].currVal;\
\cf2 285 \cf0 ProxSensors[i].prevChangeTime = millis();\
\cf2 286 \cf0 \}\
\cf2 287 \cf0 \}\
\cf2 288 \cf0 \}\
\cf2 289 \cf0 // *****************************************************************************//\
\cf2 290\
291 \cf0 //******************************************************************************//\
\cf2 292 \cf0 // The state machine:\
\cf2 293 \cf0 switch (state) \{\
\cf2 294 \cf0 //****************************************************************************//\
\cf2 295 \cf0 // In the CALIBRATE state, we move the mechanism to a position outside of the\
\cf2 296 \cf0 // work space (towards the limit switch). Once the limit switch is on and\
\cf2 297 \cf0 // the motor has stopped turning, we know that we are against the end stop\
\cf2 298 \cf0 case CALIBRATE:\
\cf2 299 \cf0 // We don't have to do anything here since this state is only used to set\
\cf2 300 \cf0 // a fixed output voltage. This happens further below.\
\cf2 301\
302 \cf0 // Decide what to do next:\
\cf2 303 \cf0 if (digitalRead(PIN_NRL_LIMIT_SWITCH)==HIGH && motorVelocity==0) \{\
\cf2 304 \cf0 // We reached the endstop. Update the motor position to the limit:\
\cf2 305 \cf0 // (NOTE: If the limit switch is on the right, this must be UPPER_BOUND)\
\cf2 306 \cf0 motorPosition = LOWER_BOUND;\
\cf2 307 \cf0 // Reset the error integrator:\
\cf2 308 \cf0 integralError = 0;\
\cf2 309 \cf0 // Calibration is finalized. Transition into DETERMINE_ACTIVE_TARGETS state\
\cf2 310 \cf0 Serial.println("State transition from CALIBRATE to CHOOSE_ACTIVE_TARGET");\
\cf2 311 \cf0 state = CHOOSE_ACTIVE_TARGET;\
\cf2 312 \cf0 \}\
\cf2 313\
314 \cf0 // Otherwise we continue calibrating\
\cf2 315 \cf0 break;\
\cf2 316\
317 \cf0 //****************************************************************************//\
\cf2 318 \cf0 // In the DETERMINE_ACTIVE_TARGETS state, we use the most recent reading of the\
photosensors to\
\cf2 319 \cf0 // calculate the location of each zombie.\
\cf2 320 \cf0 // We then select an active target to move toward based on which zombie is closest\
to the plants.\
\cf2 321 \cf0 // We default to WAIT_POSITION if no targets are active.\
\cf2 322 \cf0 case CHOOSE_ACTIVE_TARGET:\
\cf2 323\
324 \cf0 // Decide what zombie is closest to the photosensor\
\cf2 325 \cf0 // Current closest zombie is out of bounds\
\cf2 326 \cf0 minIndex = -1;\
\cf2 327 \cf0 // Set distance to 2 to be above any possible percentage values + noise\
\cf2 328 \cf0 closestZombieDist = 2;\
\cf2 329\
330 \cf0 for (int i = 0; i < sizeof(targetArr)/sizeof(int); i++) \{\
\cf2 331 \cf0 // Use the target array for the proper indexes into other arrays\
\cf2 332 \cf0 idx = targetArr[i];\
\cf2 333\
334 \cf0 // Calculate the distance to the front of the rail by taking a percentage of how\
much rail\
\cf2 335 \cf0 // the zombie has left to travel.\
\cf2 336 \cf0 Zombies[idx] = (ProxSensors[idx].currVal - ProxRange[idx][1]) /\
(ProxRange[idx][0] - ProxRange[idx][1]);\
\cf2 337\
338 \cf0 // Check to see if the zombie is traveling forward and it is closer than the\
previous zombie\
\cf2 339 \cf0 if (ProxSensors[idx].direction == FORWARD && Zombies[idx] < closestZombieDist) \{\
\cf2 340 \cf0 // update the newest minimum value\
\cf2 341 \cf0 closestZombieDist = Zombies[idx];\
\cf2 342 \cf0 // update the index of the active target (in the targetArr array)\
\cf2 343 \cf0 minIndex = i;\
\cf2 344 \cf0 \}\
\cf2 345 \cf0 \}\
\cf2 346\
347 \cf0 // if the min index points to a valid target, move to that target\
\cf2 348 \cf0 if (minIndex >= 0) \{\
\cf2 349 \cf0 activeTargetIndex = targetArr[minIndex];\
\cf2 350 \cf0 activeTargetPosition = targetPos[activeTargetIndex];\
\cf2 351 \cf0 WAIT_POS = false;\
\cf2 352 \cf0 // Serial.println("Setting position to something other than wait");\
\cf2 353 \cf0 \} else \{\
\cf2 354 \cf0 activeTargetPosition = WAIT_POSITION;\
\cf2 355 \cf0 WAIT_POS = true;\
